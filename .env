# ========================================================
# OmniRoute — Dev-Ready .env (branch: dev-setup)
# Generated for local development on localhost:20128
# ========================================================

# ── REQUIRED SECRETS (generate your own for production) ──
# openssl rand -base64 48
JWT_SECRET=dev-jwt-secret-change-me-before-production

# openssl rand -hex 32
API_KEY_SECRET=dev-api-key-secret-change-me-before-production

# Change this before first login
INITIAL_PASSWORD=CHANGEME

# ── DATABASE ──
# Stores SQLite DB in ./data (same dir as npm run dev)
DATA_DIR=./data
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEY_VERSION=v1
DISABLE_SQLITE_AUTO_BACKUP=false

# ── REDIS (Rate Limiting) ──
# Install Redis locally or comment out if not using rate limiting
REDIS_URL=redis://localhost:6379

# ── NETWORK ──
PORT=20128
NODE_ENV=development

# ── URLS ──
BASE_URL=http://localhost:20128
NEXT_PUBLIC_BASE_URL=http://localhost:20128

# ── SECURITY (relaxed for local dev) ──
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false
ALLOW_API_KEY_REVEAL=false
MACHINE_ID_SALT=endpoint-proxy-salt

# ── PROXY (disable SOCKS5 for basic local dev) ──
ENABLE_SOCKS5_PROXY=false
NEXT_PUBLIC_ENABLE_SOCKS5_PROXY=false

# ── LOGGING ──
APP_LOG_TO_FILE=true

# ── DEV PERFORMANCE ──
OMNIROUTE_USE_TURBOPACK=1

# ── OAUTH CLIENT IDs (built-in defaults — work on localhost) ──
CLAUDE_OAUTH_CLIENT_ID=9d1c250a-e61b-44d9-88ed-5944d1962f5e
CODEX_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
QWEN_OAUTH_CLIENT_ID=f0304373b74a44d2b584a3fb70ca9e56
KIMI_CODING_OAUTH_CLIENT_ID=17e5f671-d194-4dfb-9706-5516cb48c098
GITHUB_OAUTH_CLIENT_ID=Iv1.b507a08c87ecfe98

# ── USER-AGENT STRINGS ──
CLAUDE_USER_AGENT="claude-cli/2.1.146 (external, cli)"
CODEX_USER_AGENT="codex-cli/0.132.0 (Windows 10.0.26200; x64)"
GITHUB_USER_AGENT="GitHubCopilotChat/0.45.1"
ANTIGRAVITY_USER_AGENT="antigravity/2.0.1 linux/arm64 google-api-nodejs-client/10.3.0"
KIRO_USER_AGENT="AWS-SDK-JS/3.0.0 kiro-ide/1.0.0"
QODER_USER_AGENT="Qoder-Cli"
QWEN_USER_AGENT="QwenCode/0.15.11 (linux; x64)"
CURSOR_USER_AGENT="Cursor/3.4"
GEMINI_CLI_USER_AGENT="google-api-nodejs-client/10.3.0"

# ── PROVIDER LIMITS SYNC ──
PROVIDER_LIMITS_SYNC_INTERVAL_MINUTES=70
